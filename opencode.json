{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/ENGINEERING_CONTRACT.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git rev-parse*": "allow",
      "git branch*": "allow",
      "git log*": "allow",
      "git grep*": "allow",
      "git ls-files*": "allow",
      "git show*": "allow",
      "gradlew.bat *": "ask",
      "./gradlew *": "ask"
    },
    "webfetch": "ask"
  }
}