<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="InfiniPaint 90Hz Fix" android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="false">
        <!-- The diagnostic JNI renderer owns one process-wide camera and GL cache.
             A second independently resumed canvas must not share those names. -->
        <activity android:name="com.infinipaint.demo.MainActivity" android:launchMode="singleInstance"
            android:exported="true" android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
